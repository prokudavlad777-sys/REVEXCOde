{
  "name": "revex-code",
  "version": "1.0.0",
  "description": "REVEX CODE — local AI coder for Windows",
  "main": "src/main/index.js",
  "author": "REVEX",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "tesseract.js": "^5.1.0",
    "monaco-editor": "^0.50.0",
    "marked": "^12.0.2",
    "highlight.js": "^11.9.0",
    "dompurify": "^3.1.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.revex.code",
    "productName": "REVEX CODE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!**/*.map"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}